<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox styleClass="panel" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.rutaverde.controlador.ActividadesControlador">
    <VBox styleClass="tarjeta" prefWidth="340" minWidth="320">
        <Label text="Actividad" styleClass="seccion"/>
        <GridPane hgap="8" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="120"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Código" GridPane.rowIndex="0"/>
            <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Nombre" GridPane.rowIndex="1"/>
            <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Municipio" GridPane.rowIndex="2"/>
            <TextField fx:id="txtMunicipio" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Duración (horas)" GridPane.rowIndex="3"/>
            <TextField fx:id="txtDuracion" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Precio por persona" GridPane.rowIndex="4"/>
            <TextField fx:id="txtPrecio" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Cupo máximo por día" GridPane.rowIndex="5"/>
            <TextField fx:id="txtCupo" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label text="Dificultad" GridPane.rowIndex="6"/>
            <ComboBox fx:id="cmbDificultad" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            <Label text="Estado" GridPane.rowIndex="7"/>
            <ComboBox fx:id="cmbEstado" maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox spacing="8">
            <Button text="Agregar" styleClass="primario" onAction="#onAgregar"/>
            <Button text="Actualizar" onAction="#onActualizar"/>
            <Button text="Eliminar" onAction="#onEliminar"/>
            <Button text="Limpiar" onAction="#onLimpiar"/>
        </HBox>
    </VBox>
    <TableView fx:id="tblActividades" HBox.hgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código"/>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colMunicipio" text="Municipio"/>
            <TableColumn fx:id="colDuracion" text="Horas"/>
            <TableColumn fx:id="colPrecio" text="Precio/persona"/>
            <TableColumn fx:id="colCupo" text="Cupo/día"/>
            <TableColumn fx:id="colDificultad" text="Dificultad"/>
            <TableColumn fx:id="colEstado" text="Estado"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</HBox>
