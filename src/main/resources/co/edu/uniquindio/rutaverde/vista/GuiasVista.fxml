<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox styleClass="panel" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.rutaverde.controlador.GuiasControlador">
    <VBox styleClass="tarjeta" prefWidth="340" minWidth="320">
        <Label text="Guía" styleClass="seccion"/>
        <GridPane hgap="8" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="110"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Identificación" GridPane.rowIndex="0"/>
            <TextField fx:id="txtIdentificacion" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Nombre" GridPane.rowIndex="1"/>
            <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Idiomas" GridPane.rowIndex="2"/>
            <TextField fx:id="txtIdiomas" promptText="Español, Inglés" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Teléfono" GridPane.rowIndex="3"/>
            <TextField fx:id="txtTelefono" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Tarifa por día" GridPane.rowIndex="4"/>
            <TextField fx:id="txtTarifa" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox spacing="8">
            <Button text="Agregar" styleClass="primario" onAction="#onAgregar"/>
            <Button text="Actualizar" onAction="#onActualizar"/>
            <Button text="Eliminar" onAction="#onEliminar"/>
            <Button text="Limpiar" onAction="#onLimpiar"/>
        </HBox>
    </VBox>
    <TableView fx:id="tblGuias" HBox.hgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIdentificacion" text="Identificación"/>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colIdiomas" text="Idiomas"/>
            <TableColumn fx:id="colTelefono" text="Teléfono"/>
            <TableColumn fx:id="colTarifa" text="Tarifa por día"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</HBox>
